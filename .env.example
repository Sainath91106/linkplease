# Copy this file to .env for local development
# Do NOT commit your real .env file.

# Required for webhook signature verification and API calls
PSEUDOGRAM_API_KEY=your_key_here

# Optional (default shown)
PSEUDOGRAM_BASE_URL=https://pseudogram-api.onrender.com

# Optional local DB path (default: linkplease.db at project root)
DB_PATH=linkplease.db
